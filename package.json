{
  "name": "astravault",
  "version": "1.0.0",
  "private": true,
  "description": "Aerospace and space mission intelligence database system.",
  "scripts": {
    "dev": "node -r ./scripts/patch-readlink.cjs ./node_modules/next/dist/bin/next dev",
    "build": "prisma generate && node -r ./scripts/patch-readlink.cjs ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.1.0",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "leaflet": "1.9.4",
    "lucide-react": "0.468.0",
    "next": "15.5.18",
    "next-auth": "4.24.14",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-leaflet": "5.0.0",
    "recharts": "2.15.0",
    "tailwind-merge": "2.6.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@types/bcryptjs": "2.4.6",
    "@types/leaflet": "1.9.16",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
    "eslint-config-next": "15.5.18",
    "postcss": "8.5.10",
    "prisma": "6.1.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
